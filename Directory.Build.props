<Project>

  <PropertyGroup>
    <!-- Central version of the project (single source of truth) -->
    <Version>2.8.2</Version>

    <!-- Default multi-targeting for all projects -->
    <!-- Individual projects can override if they need specific frameworks (e.g., source generators using netstandard2.0) -->
    <SupportedTargetFrameworks>net8.0;net9.0;net10.0;net11.0</SupportedTargetFrameworks>

    <!-- SDKs CI installs for the older targets' runtimes and NativeAOT toolchains. -->
    <!-- Servicing updates include the patched NativeAOT toolchains. -->
    <!-- The SDK that builds everything is pinned once, in global.json (sdk.version). -->
    <SupportedSdkVersions>8.0.427;9.0.320;10.0.403</SupportedSdkVersions>

    <!-- Enforce EditorConfig code style during build so style violations fail when TreatWarningsAsErrors=true -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Compiler and build settings -->
  <PropertyGroup>
    <!-- Keep the language contract compatible with the .NET 10 SDK when building with newer SDKs. -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringCompilation>true</RunAnalyzersDuringCompilation>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Source Link and reproducible builds -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Test and Benchmark project settings -->
  <PropertyGroup
    Condition="$(MSBuildProjectName.Contains('Tests')) Or $(MSBuildProjectName.Contains('Benchmarks'))">
    <IsPackable>false</IsPackable>
    <!-- CS1591: Missing XML comment for publicly visible type or member -->
    <NoWarn>$(NoWarn);CS1591;IDE1006</NoWarn>
  </PropertyGroup>

</Project>
