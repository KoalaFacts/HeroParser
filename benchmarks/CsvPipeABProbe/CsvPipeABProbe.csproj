<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HeroParser/HeroParser.csproj" />
    <Reference Include="HeroParser.Baseline">
      <HintPath>$(BaselineDll)</HintPath>
      <Aliases>baseline</Aliases>
    </Reference>
  </ItemGroup>
  <Target Name="RequireBaseline" BeforeTargets="ResolveReferences" Condition="'$(BaselineDll)' == ''">
    <Error Text="Pass -p:BaselineDll=&lt;path to an independently built baseline assembly&gt;." />
  </Target>
</Project>
