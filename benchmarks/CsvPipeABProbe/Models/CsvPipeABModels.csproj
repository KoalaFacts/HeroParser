<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <GeneratorProject Condition="'$(GeneratorProject)' == ''">../../../src/HeroParser.Generators/HeroParser.Generators.csproj</GeneratorProject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HeroParser">
      <HintPath>$(ParserDll)</HintPath>
    </Reference>
    <ProjectReference Include="$(GeneratorProject)"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="AssemblyName;ParserDll;GeneratorProject;BaseIntermediateOutputPath;OutputPath" />
  </ItemGroup>
  <Target Name="RequireParser" BeforeTargets="ResolveReferences" Condition="!Exists('$(ParserDll)')">
    <Error Text="Pass -p:ParserDll=&lt;path to the parser assembly used by these generated models&gt;." />
  </Target>
</Project>
