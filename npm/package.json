{
  "name": "heroparser-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "tests"
  ],
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=12.0.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents": false,
    "onnxruntime-node": false,
    "protobufjs": false
  },
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "postinstall": "node scripts/apply-patches.js"
  },
  "devDependencies": {
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-web": "1.20.1"
    },
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  }
}
