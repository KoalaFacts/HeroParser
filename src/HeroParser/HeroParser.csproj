<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <!-- Package metadata -->
    <PackageId>HeroParser</PackageId>
    <Authors>HeroParser Contributors</Authors>
    <Description>High-performance CSV, Fixed-Width, Excel (.xlsx), JSONL, and HTB (High-Throughput Tabular Binary) parser and writer for .NET 8+. SIMD-accelerated, low-allocation parsing with fluent read/write APIs. Fixed-Width support includes field alignment, padding, overflow handling, and async streaming. Excel reading and writing use no extra dependencies. JSONL supports AI/ML pipelines, CSV-to-JSONL conversion, embedding-API batching, and AOT-safe JsonTypeInfo. HTB supports float[] arrays for vector embedding serialization with endianness safety. Includes async I/O, source generators for native AOT, IDataReader/DbDataReader bridges, PipeReader streaming, LINQ-style extensions, progress reporting, and custom type converters.</Description>
    <PackageReleaseNotes>v2.7.0 introduces scan-ahead row batches for the CSV span readers (UTF-8 and UTF-16), an inline quoted-chunk fast path and a UTF-16 pack-and-saturate front end. Fixes MaxFieldSize enforcement inside the SIMD block path and SourceLineNumber attribution before multi-line quoted fields. Full changelog: https://github.com/KoalaFacts/HeroParser/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>csv;csvhelper;csv parser;csv reader;csv writer;fixed-width;fixedwidth;fixed-length;mainframe;excel;xlsx;excel reader;excel writer;delimited;tsv;parser;writer;rfc4180;jsonl;json;ndjson;simd;aot;high-performance;llm;embeddings;dataset;fine-tuning;openai;anthropic;vector;ai</PackageTags>
    <RepositoryUrl>https://github.com/KoalaFacts/HeroParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Documentation and symbols -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeroParser.Tests" />
    <InternalsVisibleTo Include="HeroParser.Generators.Tests" />
    <InternalsVisibleTo Include="HeroParser.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeroParser.Generators\HeroParser.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\..\..\..\HeroParser.Generators\bin\$(Configuration)\netstandard2.0\HeroParser.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
