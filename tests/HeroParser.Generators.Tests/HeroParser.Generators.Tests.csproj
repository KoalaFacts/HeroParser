<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <!-- Source Generator Testing - only needs Roslyn compiler APIs -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference HeroParser for attribute definitions and runtime APIs -->
    <ProjectReference Include="../../src/HeroParser/HeroParser.csproj" />
    <!-- Reference generator as assembly for unit testing -->
    <ProjectReference Include="../../src/HeroParser.Generators/HeroParser.Generators.csproj" />
    <!-- Also reference as analyzer for integration tests with generated code -->
    <ProjectReference Include="../../src/HeroParser.Generators/HeroParser.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
